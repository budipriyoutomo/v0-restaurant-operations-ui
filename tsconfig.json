{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-buildcheck/types/**/*.ts",
    ".next-buildcheck/dev/types/**/*.ts",
    ".next-pwa/types/**/*.ts",
    ".next-pwa/dev/types/**/*.ts",
    ".next-e2e-prod/types/**/*.ts",
    ".next-e2e-prod/dev/types/**/*.ts",
    ".next-verA/types/**/*.ts",
    ".next-verA/dev/types/**/*.ts",
    ".next-verB/types/**/*.ts",
    ".next-verB/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-e2e"
  ]
}
